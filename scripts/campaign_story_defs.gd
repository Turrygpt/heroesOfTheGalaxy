		["ridus", "Мои транспорты уже разворачиваются к Марсу. Первый раз за полгода мы летим туда не вслепую."],
	],
}

static func lines(id: String) -> Array:
	var result: Array = []
	for entry in DIALOGUES.get(id, []):
		result.append({"speaker": entry[0], "text": entry[1]})
	return result
