var map: Node2D
var busy := false
const TITLES := {
	"secret_caravan": "Тихая частота",
	"arrival": "Зачем мы у Сатурна", "moon_base": "Свой берег на Тефии",
	"contact_1": "Цена прохода", "capture_1": "Чужие долги",
	"contact_2": "Воздух Ночной Вуали", "capture_2": "Отменённый рейс",
	"contact_3": "Страховка Дрейка", "capture_3": "Не включать передатчик",
	"archive_3": "Два объекта Древних", "cruisers_ready": "Корабль с Тефии",
	"contact_4": "Контракт на молчание", "capture_4": "Последний рубеж",
	"archive_4": "Первый ответ", "ending": "Право знать",
}

func _ready() -> void:
	map = get_parent()
	for key in ["saturn_seen", "saturn_pending"]:
		if not map.story_state.has(key):
			map.story_state[key] = []

func enqueue(id: String) -> void:
	if SCENES.has(id) and not map.story_state.saturn_seen.has(id) and not map.story_state.saturn_pending.has(id):
		map.story_state.saturn_pending.append(id)

func update_progress() -> void:
	if bool(map.story_state.get("moon_base_built", false)) and int(map._player_hero().army.get("earth_cruiser", 0)) > 0:
		enqueue("cruisers_ready")

## Только уже показанные сцены: журнал не раскрывает следующие повороты и не выдаёт награды.
func history_pages() -> Array[Dictionary]:
	var pages: Array[Dictionary] = []
	for id in map.story_state.saturn_seen:
		var rows: Array = resolved_lines(String(id))
		for start in range(0, rows.size(), 3):
			var paragraphs: Array[String] = []
			for index in range(start, mini(start + 3, rows.size())):
				var speaker: String = preload("res://scripts/intro_dialogue.gd").SPEAKERS[rows[index].speaker].name
				paragraphs.append(speaker + ":\n" + String(rows[index].text))
			pages.append({"title": TITLES.get(id, id), "text": "\n\n".join(paragraphs)})
	return pages

func show_history(page: int = 0) -> void:
	var pages := history_pages()
	if pages.is_empty():
		map._show_object_reward_dialog("Радиожурнал", "Здесь сохранятся прочитанные переговоры экспедиции.")
		return
	page = clampi(page, 0, pages.size() - 1)
	var choices: Array[Dictionary] = [
		{"id": "previous", "label": "Назад", "disabled": page == 0},
		{"id": "next", "label": "Далее", "disabled": page == pages.size() - 1},
		{"id": "close", "label": "Закрыть"}]
	map._show_object_choice_dialog("%s · %d / %d" % [pages[page].title, page + 1, pages.size()], pages[page].text, choices, null,
		func(choice: String) -> void:
			if choice != "close":
				show_history(page + (1 if choice == "next" else -1))
	)

func _process(_delta: float) -> void:
	update_progress()
	if busy or map.story_state.saturn_pending.is_empty() or not map.is_processing() or map.is_moving or map.reward_dialog_count > 0:
		return
	if OS.has_feature("headless"):
		return
	var id := String(map.story_state.saturn_pending[0])
	var dialogue := preload("res://scripts/intro_dialogue.gd").new()
	dialogue.dialogue_lines = resolved_lines(id)
	busy = true
	map.set_process(false)
	map.set_process_unhandled_input(false)
	dialogue.finished.connect(func() -> void:
		complete(id)
		busy = false
		map.set_process(true)
		map.set_process_unhandled_input(true)
	)
	map.add_child(dialogue)

func resolved_lines(id: String) -> Array:
	var result := lines(id)
	if id == "arrival":
		var transfer: Dictionary = map.story_state.get("artifact_transfer", {})
		if not transfer.is_empty():
			result.append({"speaker": "admiral", "text": "Артефакты с Марса переданы на Землю для исследования: %d. По 1000 кредитов за каждый — всего %d кредитов на счёт экспедиции." % [int(transfer.count), int(transfer.credits)]})
			result.append({"speaker": "pavlova", "text": "Передачу подтвердила. На борту артефактов больше нет. Пусть теперь исследуют их в лаборатории, а нам пригодятся деньги на базу."})
	return result

static func lines(id: String) -> Array:
	var result := []
	for row in SCENES.get(id, []):
		result.append({"speaker": row[0], "text": row[1]})
	return result

func complete(id: String) -> void:
	map.story_state.saturn_pending.erase(id)
	if not map.story_state.saturn_seen.has(id):
		map.story_state.saturn_seen.append(id)
	if id == "ending":
		map.campaign_outcome = "victory"
		map._save_campaign()
		map._show_campaign_outcome(true, "АВРОРА-S2", "Тайна Энцелада раскрыта. Источник технологии «Авроры» найден, база на Тефии закреплена.")
