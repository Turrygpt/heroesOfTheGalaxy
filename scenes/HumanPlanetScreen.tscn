[sub_resource type="Shader" id="Shader_procedural_clouds"]
code = "shader_type canvas_item;

float hash_21(vec2 point) {
	point = fract(point * vec2(123.34, 456.21));
	point += dot(point, point + 45.32);
	return fract(point.x * point.y);
}

float value_noise(vec2 point) {
	vec2 cell = floor(point);
	vec2 local = fract(point);
	local = local * local * (3.0 - 2.0 * local);
	float a = hash_21(cell);
	float b = hash_21(cell + vec2(1.0, 0.0));
	float c = hash_21(cell + vec2(0.0, 1.0));
	float d = hash_21(cell + vec2(1.0, 1.0));
	return mix(mix(a, b, local.x), mix(c, d, local.x), local.y);
}

float fbm(vec2 point) {
	float value = 0.0;
	float amplitude = 0.55;
	for (int index = 0; index < 5; index++) {
		value += value_noise(point) * amplitude;
		point = point * 2.03 + vec2(17.1, 9.2);
		amplitude *= 0.48;
	}
	return value;
}

void fragment() {
	vec2 uv = UV;
	// Три слоя движутся с разной скоростью и даже в разных направлениях.
	float far_layer = fbm(vec2(uv.x * 4.2 + TIME * 0.0035, uv.y * 10.5 + 2.0));
	float middle_layer = fbm(vec2(uv.x * 5.8 + TIME * 0.0085 + 8.0, uv.y * 13.0));
	float near_layer = fbm(vec2(uv.x * 7.0 - TIME * 0.014 + 19.0, uv.y * 15.5 + 5.0));
	float cloud_detail = fbm(vec2(uv.x * 12.0 + TIME * 0.005, uv.y * 22.0 + 13.0));

	float upper_band = smoothstep(0.035, 0.10, uv.y) * (1.0 - smoothstep(0.29, 0.40, uv.y));
	float horizon_band = smoothstep(0.17, 0.23, uv.y) * (1.0 - smoothstep(0.35, 0.44, uv.y));
	float far_clouds = smoothstep(0.52, 0.69, far_layer * 0.84 + cloud_detail * 0.16) * upper_band;
	float middle_clouds = smoothstep(0.56, 0.72, middle_layer * 0.82 + cloud_detail * 0.18) * upper_band;
	float near_clouds = smoothstep(0.60, 0.75, near_layer) * horizon_band;
	float alpha = clamp(far_clouds * 0.24 + middle_clouds * 0.27 + near_clouds * 0.18, 0.0, 0.46);
	vec3 cloud_color = mix(vec3(0.68, 0.84, 1.0), vec3(0.98, 0.995, 1.0), cloud_detail);
	COLOR = vec4(cloud_color, alpha);
}"

